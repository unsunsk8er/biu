{
  "name": "biu",
  "private": true,
  "version": "2.0.0",
  "description": "biu - 基于 Bilibili 的鸿蒙手机音乐播放器",
  "author": "Hanversion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unsunsk8er/biu.git"
  },
  "homepage": "https://github.com/unsunsk8er/biu#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint . --max-warnings 40",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run verify && npm run lint && npm run test",
    "build": "vite build",
    "preview": "vite preview",
    "smoke:harmony": "node scripts/smoke-harmony-device.mjs",
    "e2e:harmony": "node scripts/e2e-harmony-playback.mjs",
    "harmony:phone:prepare": "node scripts/build-harmony-web.mjs && node scripts/prepare-harmony-phone.mjs",
    "harmony:phone:build": "npm run harmony:phone:prepare && node scripts/build-harmony-phone.mjs",
    "harmony:phone:release": "npm run harmony:phone:prepare && node scripts/build-harmony-phone.mjs release"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^10.13.0",
    "framer-motion": "^12.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
